# Salin ke .env lalu isi. File .env diabaikan git (lihat .gitignore), jadi tidak ikut ter-push.
# Daftar key Gemini dipisah koma (sebaiknya tiap key dari project Google Cloud berbeda).
GEMINI_KEYS=key1,key2,key3
# Token untuk klien API dan untuk masuk ke UI chat: Authorization: Bearer <GATEWAY_TOKEN>
# Buat dengan: openssl rand -hex 32
GATEWAY_TOKEN=ganti-dengan-token-rahasia
